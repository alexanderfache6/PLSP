    "data_path": "/projectnb/modislc/users/fache/data/planet/phenologyGeotiff/",
    "metric_layers": [
        {
            "path": "02_{year}_OGI.tif"
        },
        {
            "path": "03_{year}_50PCGI.tif"
        },
        {
            "path": "04_{year}_OGMx.tif"
        },
        {
            "path": "05_{year}_Peak.tif"
        },
        {
            "path": "06_{year}_OGD.tif"
        },
        {
            "path": "07_{year}_50PCGD.tif"
        },
        {
            "path": "08_{year}_OGMn.tif"
        }
    ],
    "derived_features": [
        {
            "name": "DurGU",
            "description": "duration of greenness increase",
            "metric1": "OGMx",
            "metric2": "OGI",
            "operation": "-"
        },
        {
            "name": "DurGD",
            "description": "duration of greenness decrease",
            "metric1": "OGMn",
            "metric2": "OGD",
            "operation": "-"
        },
        {
            "name": "LOS",
            "description": "length of growing season",
            "metric1": "OGMn",
            "metric2": "OGI",
            "operation": "-"
        }
    ],
    "qa": {
        "fill_value": 32767,
        "logic": "AND",
        "layers": [
            {
                "path": "01_{year}_NumCycles.tif",
                "valid_range": [
                    1,
                    1
                ]
            },
            {
                "path": "12_{year}_QA.tif",
                "valid_range": [
                    1,
                    2
                ]
            }
        ]
    },
    "sampling": {
        "method": "stratified_grid",
        "cell_size_px": 30,
        "samples_per_cell": 1,
        "random_seed_base": 6
    },
    "models": {
        "kmeans": {},
        "gmm": {}
    },
    "report": "report.json",
    "results": {
        "step_1_3": {
            "sampled_pixels_template": "03_{year}_sampled_metric_pixels.csv"
        },
        "step_1_4": {
            "combined_features_template": "04_{year}_combined_features.csv"
        },
        "step_1_5": {
            "scaled_features_template": "05_{year}_scaled_features.csv",
            "scaler_template": "05_{year}_scaler.joblib"
        }
    }



    "preprocessing": {
        "scaling": "standard"
    },

    # NOTE below is old, new steps will update
    

    "pca": {
        "run": true,
        "n_components": null
    },
    "clustering": {
        "methods": [
            "kmeans",
            "gmm",
            "hdbscan"
        ],
        "kmeans": {
            "k_range": [
                2,
                15
            ]
        },
        "gmm": {
            "k_range": [
                2,
                15
            ],
            "covariance_type": "full"
        },
        "hdbscan": {
            "min_cluster_sizes": [
                100,
                250,
                500,
                1000,
                2000
            ],
            "min_samples": null
        }
    },
    "output": {
        "save_model": true,
        "save_scaler": true,
        "save_sample_table": true
    },
    "results": {
        "step03": {
