linters: linters_with_defaults(object_name_linter = object_name_linter(styles = "camelCase"), line_length_linter = line_length_linter(200), object_usage_linter = object_usage_linter(), assignment_linter = assignment_linter(), spaces_left_parentheses_linter = spaces_left_parentheses_linter(), infix_spaces_linter = infix_spaces_linter(), commented_code_linter = NULL, trailing_whitespace_linter = trailing_whitespace_linter(), trailing_blank_lines_linter = trailing_blank_lines_linter(), indentation_linter = indentation_linter(indent = 2L))
